# Dockerfile para el frontend Angular CCTV
FROM node:20-alpine as build
WORKDIR /app

# Copiar package.json y package-lock.json desde cctv-frontend
COPY cctv-frontend/package*.json ./

# Instalar dependencias
RUN npm install

# Copiar todo el código fuente de cctv-frontend
COPY cctv-frontend/ ./

# Construir la aplicación Angular para producción
RUN npm run build

# Verificar que se construyó correctamente
RUN ls -la dist/
RUN ls -la dist/cctv-frontend/

FROM nginx:alpine

# Remover la configuración por defecto de nginx
RUN rm /etc/nginx/conf.d/default.conf

# Copiar los archivos construidos de Angular
COPY --from=build /app/dist/cctv-frontend /usr/share/nginx/html

# Copiar nuestra configuración personalizada de nginx
COPY cctv-frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Verificar que los archivos se copiaron correctamente
RUN ls -la /usr/share/nginx/html/

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
