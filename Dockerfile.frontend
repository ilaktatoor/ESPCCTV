# Dockerfile para el frontend Angular CCTV
FROM node:20-alpine as build
WORKDIR /app

# Copiar todo el proyecto frontend
COPY cctv-frontend/ ./

# Instalar dependencias
RUN npm ci

# Construir la aplicación
RUN npm run build

# Debug: verificar todo lo que se construyó
RUN echo "=== ESTRUCTURA COMPLETA DESPUÉS DEL BUILD ===" && find dist -type f -exec ls -la {} \;

FROM nginx:alpine

# Eliminar todo lo que viene por defecto en nginx
RUN rm -rf /usr/share/nginx/html/* && rm -rf /etc/nginx/conf.d/*

# Copiar TODOS los archivos desde dist/cctv-frontend
COPY --from=build /app/dist/cctv-frontend/ /usr/share/nginx/html/

# Verificar qué se copió
RUN echo "=== CONTENIDO EN NGINX ===" && find /usr/share/nginx/html -type f -exec ls -la {} \;

# Usar el archivo de configuración nginx existente
COPY cctv-frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Verificar configuración
RUN cat /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
