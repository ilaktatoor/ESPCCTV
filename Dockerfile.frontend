# Dockerfile para el frontend Angular CCTV
FROM node:20-alpine as build
WORKDIR /app

# Copiar todo el proyecto frontend
COPY cctv-frontend/ ./

# Instalar dependencias
RUN npm ci

# Construir la aplicación
RUN npm run build

# Verificar la construcción
RUN echo "=== Build output ===" && ls -la dist/
RUN echo "=== Build content ===" && ls -la dist/cctv-frontend/

FROM nginx:alpine

# Limpiar nginx por defecto
RUN rm -rf /usr/share/nginx/html/*
RUN rm /etc/nginx/conf.d/default.conf

# Copiar archivos construidos desde la carpeta browser
COPY --from=build /app/dist/cctv-frontend/browser/ /usr/share/nginx/html/

# Verificar contenido final
RUN echo "=== Final nginx content ===" && ls -la /usr/share/nginx/html/

# Crear configuración nginx
COPY cctv-frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
