FROM node:20-alpine as build
WORKDIR /app
COPY cctv-frontend/ ./
RUN npm ci
RUN npm run build
RUN echo "=== Build files ===" && find dist -name "*.html" -o -name "*.js" -o -name "*.css"
RUN echo "=== Build structure ===" && ls -la dist/

FROM nginx:alpine
RUN rm -rf /usr/share/nginx/html/*
RUN rm /etc/nginx/conf.d/default.conf

# Copiar desde browser si existe, sino desde la raíz de dist
COPY --from=build /app/dist/cctv-frontend/browser/ /usr/share/nginx/html/ 2>/dev/null || \
COPY --from=build /app/dist/cctv-frontend/ /usr/share/nginx/html/

RUN echo "=== Final files ===" && ls -la /usr/share/nginx/html/
RUN echo "=== HTML check ===" && ls -la /usr/share/nginx/html/*.html || echo "No HTML files found"

COPY cctv-frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
