FROM node:20-alpine as build
WORKDIR /app
COPY cctv-frontend/ ./
RUN npm ci
RUN npm run build

# Debug stage para ver qué se generó
RUN echo "=== Contenido de dist ===" && find dist -type f

FROM nginx:alpine
RUN rm -rf /usr/share/nginx/html/*

# Copiar todo el contenido de dist recursivamente
COPY --from=build /app/dist/ /usr/share/nginx/html/

# Asegurar permisos
RUN chmod -R 755 /usr/share/nginx/html
RUN chown -R nginx:nginx /usr/share/nginx/html

# Configuración nginx
COPY cctv-frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Debug final
RUN echo "=== Archivos finales ===" && ls -la /usr/share/nginx/html/
RUN echo "=== Archivos HTML ===" && find /usr/share/nginx/html -name "*.html" -exec ls -la {} \;

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]