FROM node:20-alpine as build
WORKDIR /build
COPY cctv-frontend/package*.json ./
RUN npm ci
COPY cctv-frontend/ ./
RUN npm run build
RUN ls -la dist/

FROM nginx:alpine
# Limpiar nginx
RUN rm -rf /usr/share/nginx/html/*
RUN rm /etc/nginx/conf.d/default.conf

# Crear estructura básica si no existe
RUN mkdir -p /usr/share/nginx/html

# Intentar copiar desde las rutas posibles de Angular
COPY --from=build /build/dist/cctv-frontend/browser/ /usr/share/nginx/html/ 2>/dev/null || \
     COPY --from=build /build/dist/cctv-frontend/ /usr/share/nginx/html/ || \
     COPY --from=build /build/dist/ /usr/share/nginx/html/

# Crear index.html básico si no existe
RUN if [ ! -f /usr/share/nginx/html/index.html ]; then \
        echo '<h1>Angular App Loading...</h1><script>console.log("No index.html found");</script>' > /usr/share/nginx/html/index.html; \
    fi

# Configuración
COPY cctv-frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Permisos
RUN chmod -R 755 /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]